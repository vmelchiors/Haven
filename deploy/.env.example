# ==============================================================================
# 🛡️ HAVEN PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 🌐 DOMÍNIO E CERTIFICADO SSL (CADDY AUTOMÁTICO)
# Informe o domínio configurado no DNS da Hostinger (Registro A apontando para o IP da VPS)
# Exemplo: haven.seudominio.com
DOMAIN=haven.seudominio.com

# 🔗 URL DO REPOSITÓRIO GITHUB (Links de Download no App)
# Aponte para a página de releases do seu repositório GitHub.
# Formato: https://github.com/SEU_USUARIO/SEU_REPO/releases/latest
VITE_GITHUB_RELEASE_URL=https://github.com/SEU_USUARIO/Haven/releases/latest

# 🔑 AUTENTICAÇÃO JWT
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET=substitua_por_chave_gerada_com_openssl_rand_hex_32

# 🎙️ LIVEKIT SFU (WebRTC — Voz e Vídeo)
# URL interna do LiveKit (não altere)
LIVEKIT_URL=/rtc
# Chave de API do LiveKit (pode ser qualquer identificador)
LIVEKIT_API_KEY=haven_key_prod
# Segredo do LiveKit — gere com: openssl rand -hex 16
# ⚠️ DEVE ser idêntica ao LIVEKIT_API_SECRET usada no backend
LIVEKIT_API_SECRET=substitua_por_segredo_gerado_com_openssl_rand_hex_16

# 💰 PAGAMENTOS PIX
PIX_KEY=sua-chave-pix@dominio.com
PIX_RECEIVER_NAME=Haven Project
PIX_RECEIVER_CITY=Sao Paulo

# 📜 TERMOS DE SERVIÇO
TOS_CURRENT_VERSION=v1.0.0

# 📁 CAMINHOS DE PERSISTÊNCIA
DB_PATH=/data/haven.db
UPLOAD_DIR=/data/uploads
RECEIPTS_PATH=/data/receipts
PORT=8080
